<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RaceDock.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The alias catalog for manufacturer logos. Artwork ships with each front end; Core only
         resolves the asset file name so every front end picks the same logo. -->
