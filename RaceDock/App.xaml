<Application x:Class="RaceDock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Unknown" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Settings/SettingsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="MotorsportFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
</Application>
