<ui:FluentWindow x:Class="RaceDock.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:RaceDock.App"
                 Title="RaceDock Settings"
                 Width="980"
                 Height="720"
                 MinWidth="760"
                 MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="{DynamicResource MotorsportFontFamily}">
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        <Style TargetType="ui:NavigationViewItem"
           BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
            <!--  Row height comes from the icon: WPF-UI sizes the hover border to content plus a 1px border,  -->
            <!--  so a fixed item height would leave a dead band between adjacent hover surfaces.  -->
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavigationGlyphStyle"
           TargetType="ui:SymbolIcon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                 Title="RaceDock"
                 ShowMaximize="True"
                 ShowMinimize="True"
                 Panel.ZIndex="1" />

        <ui:InfoBar x:Name="ErrorBar"
                Grid.Row="1"
                Margin="16,4,16,0"
                Severity="Error"
                IsClosable="True"
                Title="Could not apply settings" />

        <local:HistoryNavigationView x:Name="RootNavigation"
                       Grid.Row="2"
                       Style="{StaticResource {x:Type ui:NavigationView}}"
                       PaneDisplayMode="Left"
                       IsPaneOpen="True"
                       IsPaneToggleVisible="True"
                       OpenPaneLength="250"
                       CompactPaneLength="48"
                       IsTopSeparatorVisible="False"
                       IsFooterSeparatorVisible="False"
                       FrameMargin="0"
                       TransitionDuration="180">
            <local:HistoryNavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="DashboardNavigationItem"
                               Content="Dashboard"
                               Tag="Dashboard"
                               Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" Style="{StaticResource NavigationGlyphStyle}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="General"
                               Tag="General"
                               Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource NavigationGlyphStyle}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Formula 1" Tag="Championship:Formula1" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/f1.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="World Endurance Championship" Tag="Championship:WorldEnduranceChampionship" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/wec.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="MotoGP" Tag="Championship:MotoGp" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/motogp.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="World Rally Championship" Tag="Championship:WorldRallyChampionship" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/wrc.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Formula E" Tag="Championship:FormulaE" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/formulae.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="IMSA WeatherTech" Tag="Championship:Imsa" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/imsa.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="INDYCAR" Tag="Championship:IndyCar" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/indycar.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="GT World Challenge" Tag="Championship:GtWorldChallengeEurope" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/gtwc.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="DTM" Tag="Championship:Dtm" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/dtm.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="European Le Mans Series" Tag="Championship:EuropeanLeMansSeries" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/elms.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Michelin Le Mans Cup" Tag="Championship:MichelinLeMansCup" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/mlmc.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Formula 2" Tag="Championship:Formula2" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/f2.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Formula 3" Tag="Championship:Formula3" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/f3.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Moto2" Tag="Championship:Moto2" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/moto2-sidebar.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Moto3" Tag="Championship:Moto3" Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <local:ChampionshipNavigationIcon Source="pack://application:,,,/RaceDock;component/Assets/ChampionshipLogos/moto3-sidebar.png" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!--  Everything lives in the menu list: the footer list is pinned and cannot scroll, so items there become unreachable in a short window.  -->
                <ui:NavigationViewItem Content="More championships"
                               Tag="MoreChampionships"
                               Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Apps24" Style="{StaticResource NavigationGlyphStyle}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="About"
                               Tag="About"
                               Click="NavigationItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" Style="{StaticResource NavigationGlyphStyle}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </local:HistoryNavigationView.MenuItems>
        </local:HistoryNavigationView>

    </Grid>
</ui:FluentWindow>
