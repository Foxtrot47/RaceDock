<Page x:Class="RaceDock.App.Settings.ChampionshipPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:RaceDock.Core;assembly=RaceDock.Core"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource SettingsPagePanelStyle}">
            <Border Style="{StaticResource SettingsChampionshipHeaderCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image MaxWidth="240"
                           MaxHeight="56"
                           HorizontalAlignment="Left"
                           Source="{Binding SelectedChampionshipPageLogo}"
                           Stretch="Uniform"
                           StretchDirection="DownOnly" />
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid DataContext="{Binding SelectedChampionshipStatus}"
                              Margin="0,0,24,0"
                              MaxWidth="260"
                              VerticalAlignment="Center">
                            <TextBlock x:Name="ChampionshipIdleText">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsStatusIdleTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUpcoming}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel HorizontalAlignment="Right"
                                        Visibility="{Binding HasUpcoming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding UpcomingEvent}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding UpcomingDetail}"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Opacity="0.6"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right"
                                        Visibility="{Binding HasTiming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock x:Name="ChampionshipEventText"
                                           Text="{Binding EventName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,3,0,0"
                                            HorizontalAlignment="Right">
                                    <Ellipse Style="{StaticResource SettingsStatusDotStyle}" />
                                    <TextBlock x:Name="ChampionshipSessionText"
                                               Text="{Binding SessionName}"
                                               FontSize="11"
                                               Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ChampionshipProgressText"
                                               Text="{Binding ProgressText}"
                                               Margin="8,0,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Opacity="0.75" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <ToggleButton x:Name="ChampionshipMasterButton"
                                      Grid.Column="1"
                                      IsChecked="{Binding SelectedChampionshipEnabled, Mode=TwoWay}"
                                      Style="{StaticResource SettingsChampionshipPowerSliderStyle}"
                                      ToolTip="Toggle live timing"
                                      AutomationProperties.Name="Enable live timing" />
                    </Grid>
                </Grid>
            </Border>

            <StackPanel IsEnabled="{Binding SelectedChampionshipEnabled}"
                        Style="{StaticResource SettingsChampionshipOptionsPanelStyle}">
            <TextBlock Text="Taskbar widget" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon NumberSymbol24}">
                <ui:CardControl.Header>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SelectedChampionshipPresentation.TaskbarCountTitle}" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock Text="{Binding SelectedChampionshipPresentation.TaskbarCountDescription}" Style="{StaticResource SettingsCardDescriptionStyle}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="TaskbarCompetitorCountSlider" Minimum="1" Maximum="5" Value="{Binding TaskbarCompetitorCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsSliderStyle}" />
                    <TextBlock Text="{Binding TaskbarCompetitorCount}" Style="{StaticResource SettingsValueStyle}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl x:Name="TaskbarManufacturerCard"
                            Style="{StaticResource SettingsCardStyle}"
                            Icon="{ui:SymbolIcon PaintBrush24}"
                            Visibility="{Binding SelectedChampionshipPresentation.ShowManufacturerSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:CardControl.Header>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SelectedChampionshipPresentation.ManufacturerTitle}" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock Text="{Binding SelectedChampionshipPresentation.TaskbarManufacturerDescription}" Style="{StaticResource SettingsCardDescriptionStyle}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding TaskbarUseManufacturerLogos, Mode=TwoWay}" Style="{StaticResource SettingsToggleStyle}" />
            </ui:CardControl>

            <TextBlock Text="Classification flyout" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon NumberSymbol24}">
                <ui:CardControl.Header>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SelectedChampionshipPresentation.FlyoutCountTitle}" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock Text="{Binding SelectedChampionshipPresentation.FlyoutCountDescription}" Style="{StaticResource SettingsCardDescriptionStyle}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="FlyoutCompetitorCountSlider" Minimum="5" Maximum="40" Value="{Binding FlyoutCompetitorCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsSliderStyle}" />
                    <TextBlock Text="{Binding FlyoutCompetitorCount}" Style="{StaticResource SettingsValueStyle}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl x:Name="FlyoutTeamCard"
                            Style="{StaticResource SettingsCardStyle}"
                            Icon="{ui:SymbolIcon TextCaseTitle24}"
                            Visibility="{Binding SelectedChampionshipPresentation.ShowTeamSetting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:CardControl.Header>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SelectedChampionshipPresentation.TeamTitle}" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock Text="{Binding SelectedChampionshipPresentation.TeamDescription}" Style="{StaticResource SettingsCardDescriptionStyle}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding FlyoutShowTeamNames, Mode=TwoWay}" Style="{StaticResource SettingsToggleStyle}" />
            </ui:CardControl>
            <ui:CardControl x:Name="FlyoutManufacturerCard"
                            Style="{StaticResource SettingsCardStyle}"
                            Icon="{ui:SymbolIcon PaintBrush24}"
                            Visibility="{Binding SelectedChampionshipPresentation.ShowManufacturerSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:CardControl.Header>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SelectedChampionshipPresentation.ManufacturerTitle}" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock Text="{Binding SelectedChampionshipPresentation.FlyoutManufacturerDescription}" Style="{StaticResource SettingsCardDescriptionStyle}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding FlyoutUseManufacturerLogos, Mode=TwoWay}" Style="{StaticResource SettingsToggleStyle}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon Color24}">
                <ui:CardControl.Header>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Position colours" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock Text="Colour the leading position cards." Style="{StaticResource SettingsCardDescriptionStyle}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding FlyoutShowPositionColors, Mode=TwoWay}" Style="{StaticResource SettingsToggleStyle}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingsCardStyle}"
                            Icon="{ui:SymbolIcon Timer24}"
                            Visibility="{Binding SelectedChampionshipPresentation.ShowSectorTimingSetting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:CardControl.Header>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Sector timing mode" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock Text="Choose current/last-lap sectors or the sectors from each driver’s best lap."
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox SelectedValue="{Binding FlyoutSectorTimeMode, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          Style="{StaticResource SettingsComboBoxStyle}">
                    <ComboBoxItem Content="Current / last lap" Tag="{x:Static core:SectorTimeMode.CurrentLast}" />
                    <ComboBoxItem Content="Best lap" Tag="{x:Static core:SectorTimeMode.BestLap}" />
                </ComboBox>
            </ui:CardControl>
            <TextBlock Text="Columns" Style="{StaticResource SettingsSubsectionTitleStyle}" />
            <TextBlock Text="Shown after the position and driver, in this order."
                       Style="{StaticResource SettingsSectionDescriptionStyle}" />
            <Border Style="{StaticResource SettingsColumnListStyle}">
                <ItemsControl x:Name="FlyoutColumnList" ItemsSource="{Binding FlyoutColumns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SettingsColumnRowStyle}"
                                    ToolTip="{Binding Description}"
                                    Visibility="{Binding IsSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Position}" Style="{StaticResource SettingsColumnPositionStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource SettingsColumnTitleStyle}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <ui:Button Style="{StaticResource SettingsColumnMoveButtonStyle}"
                                                   Icon="{ui:SymbolIcon ChevronUp24}"
                                                   IsEnabled="{Binding CanMoveUp}"
                                                   AutomationProperties.Name="{Binding MoveUpName}"
                                                   Click="MoveColumnUp_Click" />
                                        <ui:Button Style="{StaticResource SettingsColumnMoveButtonStyle}"
                                                   Icon="{ui:SymbolIcon ChevronDown24}"
                                                   IsEnabled="{Binding CanMoveDown}"
                                                   AutomationProperties.Name="{Binding MoveDownName}"
                                                   Click="MoveColumnDown_Click" />
                                        <ui:ToggleSwitch IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                         AutomationProperties.Name="{Binding Title}"
                                                         Style="{StaticResource SettingsToggleStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            </StackPanel>

            <ui:CardControl Style="{StaticResource SettingsResetCardStyle}" Icon="{ui:SymbolIcon ArrowReset24}">
                <ui:CardControl.Header>
                    <TextBlock Text="{Binding SelectedChampionshipResetLabel}" Style="{StaticResource SettingsCardTitleStyle}" />
                </ui:CardControl.Header>
                <ui:Button Style="{StaticResource SettingsResetButtonStyle}" Click="ResetButton_Click" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
