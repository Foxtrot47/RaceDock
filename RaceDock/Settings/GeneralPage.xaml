<Page x:Class="RaceDock.App.Settings.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:RaceDock.Core;assembly=RaceDock.Core"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Style="{StaticResource SettingsPagePanelStyle}">
      <TextBlock Text="General" Style="{StaticResource SettingsPageTitleStyle}" />
      <TextBlock Text="Configure app-wide behavior shared by every championship."
                 Style="{StaticResource SettingsPageDescriptionStyle}" />

      <TextBlock Text="Windows startup" Style="{StaticResource SettingsSectionTitleStyle}" />
      <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon ShareScreenStart24}">
        <ui:CardControl.Header><StackPanel HorizontalAlignment="Left"><TextBlock Text="Start RaceDock when I sign in" Style="{StaticResource SettingsCardTitleStyle}" /><TextBlock Text="Launch RaceDock automatically from its current location after signing in to Windows." Style="{StaticResource SettingsCardDescriptionStyle}" /></StackPanel></ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding AutoStartOnWindowsBoot, Mode=TwoWay}" Style="{StaticResource SettingsToggleStyle}" />
      </ui:CardControl>

      <TextBlock Text="Taskbar placement" Style="{StaticResource SettingsSectionTitleStyle}" />
      <TextBlock Text="Placement applies to the widget for every championship." Style="{StaticResource SettingsSectionDescriptionStyle}" />
      <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon ArrowMove24}">
        <ui:CardControl.Header><StackPanel HorizontalAlignment="Left"><TextBlock Text="Widget position" Style="{StaticResource SettingsCardTitleStyle}" /><TextBlock Text="Place the widget immediately beside the Windows Start area." Style="{StaticResource SettingsCardDescriptionStyle}" /></StackPanel></ui:CardControl.Header>
        <ComboBox SelectedValue="{Binding WidgetPosition, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource SettingsComboBoxStyle}"><ComboBoxItem Content="Left of Start" Tag="{x:Static core:TaskbarWidgetPosition.LeftOfStart}" /><ComboBoxItem Content="Right of Start" Tag="{x:Static core:TaskbarWidgetPosition.RightOfStart}" /></ComboBox>
      </ui:CardControl>

      <TextBlock Text="Live-session rotation" Style="{StaticResource SettingsSectionTitleStyle}" />
      <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon Timer24}">
        <ui:CardControl.Header><StackPanel HorizontalAlignment="Left"><TextBlock Text="Seconds per championship" Style="{StaticResource SettingsCardTitleStyle}" /><TextBlock Text="When several enabled championships are live, rotate between them at this interval." Style="{StaticResource SettingsCardDescriptionStyle}" /></StackPanel></ui:CardControl.Header>
        <StackPanel Orientation="Horizontal"><Slider Minimum="2" Maximum="30" Value="{Binding RotationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsSliderStyle}" /><TextBlock Text="{Binding RotationSeconds, StringFormat={}{0} s}" Style="{StaticResource SettingsValueStyle}" /></StackPanel>
      </ui:CardControl>

      <TextBlock Text="Completed sessions" Style="{StaticResource SettingsSectionTitleStyle}" />
      <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon History24}" Margin="0,0,0,14">
        <ui:CardControl.Header><StackPanel HorizontalAlignment="Left"><TextBlock Text="Keep final classification visible" Style="{StaticResource SettingsCardTitleStyle}" /><TextBlock Text="Keep the latest classification on the taskbar between sessions. A new live session replaces it immediately." Style="{StaticResource SettingsCardDescriptionStyle}" /></StackPanel></ui:CardControl.Header>
        <StackPanel Orientation="Horizontal"><Slider Minimum="5" Maximum="30" Value="{Binding CompletedSessionRetentionMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsSliderStyle}" /><TextBlock Text="{Binding CompletedSessionRetentionMinutes, StringFormat={}{0} min}" Style="{StaticResource SettingsValueStyle}" /></StackPanel>
      </ui:CardControl>
    </StackPanel>
  </ScrollViewer>
</Page>
