<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <SolidColorBrush x:Key="RaceDockStatusLiveBrush" Color="#107C10" />
  <SolidColorBrush x:Key="RaceDockStatusUpcomingBrush" Color="#9D5D00" />
  <SolidColorBrush x:Key="RaceDockStatusRedFlagBrush" Color="#C42B1C" />
  <SolidColorBrush x:Key="RaceDockStatusReplayBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="RaceDockStatusOnColorBrush" Color="White" />

  <Style x:Key="SettingsPagePanelStyle" TargetType="StackPanel">
    <Setter Property="MaxWidth" Value="1000" />
    <Setter Property="Margin" Value="16,16,16,64" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="SettingsPageDescriptionStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,5,0,20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,14,0,6" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="SettingsSectionDescriptionStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="0,-3,0,7" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="SettingsCardDescriptionStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MaxWidth" Value="500" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="SettingsStatusDotStyle" TargetType="Ellipse">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding StatusKind}" Value="Live">
        <Setter Property="Fill" Value="{StaticResource RaceDockStatusLiveBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="PreSession">
        <Setter Property="Fill" Value="{StaticResource RaceDockStatusUpcomingBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="RedFlag">
        <Setter Property="Fill" Value="{StaticResource RaceDockStatusRedFlagBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SettingsStatusBadgeStyle" TargetType="ui:InfoBadge">
    <Setter Property="Value" Value="{Binding StatusLabel}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:InfoBadge">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="6,2">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6"
                       Height="6"
                       Margin="0,0,5,0"
                       VerticalAlignment="Center"
                       Fill="{TemplateBinding Foreground}" />
              <TextBlock Text="{TemplateBinding Value}"
                         Foreground="{TemplateBinding Foreground}"
                         FontSize="{TemplateBinding FontSize}"
                         FontWeight="{TemplateBinding FontWeight}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding StatusKind}" Value="Live">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Foreground" Value="{StaticResource RaceDockStatusOnColorBrush}" />
        <Setter Property="Background" Value="{StaticResource RaceDockStatusLiveBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="PreSession">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Foreground" Value="{StaticResource RaceDockStatusOnColorBrush}" />
        <Setter Property="Background" Value="{StaticResource RaceDockStatusUpcomingBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="RedFlag">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Foreground" Value="{StaticResource RaceDockStatusOnColorBrush}" />
        <Setter Property="Background" Value="{StaticResource RaceDockStatusRedFlagBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="Ended">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationViewItem}}}" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SettingsChampionshipCardStyle" TargetType="ui:CardAction"
         BasedOn="{StaticResource {x:Type ui:CardAction}}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding StatusKind}" Value="Live">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="PreSession">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="RedFlag">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="Ended">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>


  <Style x:Key="SettingsStatusIdleTextStyle" TargetType="TextBlock">
    <Setter Property="Text" Value="&#x2014;" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="ToolTip" Value="{Binding EventName}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasTiming}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SettingsToggleStyle"
         TargetType="ui:ToggleSwitch"
         BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
  </Style>

  <Style x:Key="SettingsChampionshipPowerSliderStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="78" />
    <Setter Property="Height" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Track"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="20" />
            <Border x:Name="Thumb"
                    Width="32"
                    Height="32"
                    Margin="4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="16"
                    Background="{DynamicResource TextFillColorPrimaryBrush}">
              <Border.RenderTransform>
                <TranslateTransform x:Name="ThumbTransform" />
              </Border.RenderTransform>
              <TextBlock x:Name="PowerIcon"
                         Text="&#xE7E8;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Opacity" Value="0.82" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Track" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="PowerIcon" Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                     Storyboard.TargetProperty="X"
                                     To="38"
                                     Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                     Storyboard.TargetProperty="X"
                                     To="0"
                                     Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.4" />
              <Setter TargetName="Thumb" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsComboBoxStyle"
         TargetType="ComboBox"
         BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="MinWidth" Value="240" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style x:Key="SettingsSliderStyle"
         TargetType="Slider"
         BasedOn="{StaticResource {x:Type Slider}}">
    <Setter Property="Width" Value="220" />
    <Setter Property="TickFrequency" Value="1" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SettingsValueStyle" TargetType="TextBlock">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SettingsCardStyle"
         TargetType="ui:CardControl"
         BasedOn="{StaticResource {x:Type ui:CardControl}}">
    <Setter Property="Margin" Value="0,0,0,3" />
  </Style>

  <!--
    Testing transport bar: playback state and controls stay in one fixed place at the top of the page
    so the active feed is readable without hunting through the cards below.
  -->
  <Style x:Key="SettingsTransportBarStyle" TargetType="Border">
    <Setter Property="Margin" Value="0,0,0,14" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
  </Style>

  <Style x:Key="SettingsTransportBadgeStyle" TargetType="Border">
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
  </Style>

  <Style x:Key="SettingsTransportDotStyle" TargetType="Ellipse">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="SettingsTransportBadgeTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SettingsTransportButtonStyle"
         TargetType="ui:Button"
         BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!--  Scenario states are mutually exclusive within a row, so they read as one segmented control.  -->
  <Style x:Key="SettingsSegmentedButtonStyle"
         TargetType="ToggleButton"
         BasedOn="{StaticResource {x:Type ToggleButton}}">
    <Setter Property="Margin" Value="0,2,6,2" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="IsThreeState" Value="False" />
  </Style>

  <!--  Settings apply as they change, so each page ends with its own way back to the defaults.  -->
  <!--
    A championship configures two independent surfaces with near-identical option names, so the page shows
    one surface at a time behind a segmented switch rather than repeating "Event name" twice in one scroll.
  -->
  <!-- Groups options within a surface: quieter than a section title so the surface heading stays dominant. -->
  <Style x:Key="SettingsSubsectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,16,0,6" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!--
    The column order is one ordered list, not six unrelated settings, so the rows share a single container
    and drop their descriptions to tooltips to keep the whole arrangement visible at once.
  -->
  <Style x:Key="SettingsColumnListStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style x:Key="SettingsColumnRowStyle" TargetType="Border">
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="12,0,6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SettingsColumnPositionStyle" TargetType="TextBlock">
    <Setter Property="Width" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
  </Style>

  <Style x:Key="SettingsColumnTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <!-- Square icon-only buttons that move a classification column up or down the order. -->
  <Style x:Key="SettingsColumnMoveButtonStyle"
         TargetType="ui:Button"
         BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="SettingsResetCardStyle"
         TargetType="ui:CardControl"
         BasedOn="{StaticResource {x:Type ui:CardControl}}">
    <Setter Property="Margin" Value="0,24,0,0" />
  </Style>

  <Style x:Key="SettingsResetButtonStyle"
         TargetType="ui:Button"
         BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Content" Value="Reset" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Icon" Value="{ui:SymbolIcon ArrowReset24}" />
  </Style>

  <Style x:Key="SettingsChampionshipHeaderCardStyle" TargetType="Border">
    <Setter Property="MinHeight" Value="84" />
    <Setter Property="Margin" Value="0,0,0,18" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding SelectedChampionshipEnabled}" Value="False">
        <Setter Property="Opacity" Value="0.58" />
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               To="0.58"
                               Duration="0:0:0.2" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               To="1"
                               Duration="0:0:0.24" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SettingsChampionshipOptionsPanelStyle" TargetType="StackPanel">
    <Setter Property="Opacity" Value="1" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.38" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               To="0.38"
                               Duration="0:0:0.2" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               To="1"
                               Duration="0:0:0.24" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SettingsExpanderStyle"
         TargetType="ui:CardExpander"
         BasedOn="{StaticResource {x:Type ui:CardExpander}}">
    <Setter Property="ContentPadding" Value="16" />
    <Setter Property="Margin" Value="0,0,0,14" />
    <Setter Property="IsExpanded" Value="True" />
  </Style>
</ResourceDictionary>
