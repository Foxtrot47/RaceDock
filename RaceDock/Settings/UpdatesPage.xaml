<Page x:Class="RaceDock.App.Settings.UpdatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Style="{StaticResource SettingsPagePanelStyle}">
      <TextBlock Text="What's new"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock x:Name="SubtitleText"
                 FontSize="14"
                 Margin="4,12,0,0"
                 Opacity="0.75"
                 TextWrapping="Wrap" />

      <ui:CardAction x:Name="UpdateCard"
                     Margin="0,20,0,0"
                     Padding="16,12"
                     IsChevronVisible="False"
                     IsHitTestVisible="False"
                     Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="UpdateStatusText"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="UpdateDetailText"
                       FontSize="12"
                       Opacity="0.65"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <ui:Anchor x:Name="UpdateLink"
                       Content="Open release"
                       Icon="{ui:SymbolIcon Open24}"
                       Margin="0,0,8,0"
                       Visibility="Collapsed" />
            <ui:Button x:Name="CheckButton"
                       Content="Check for updates"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       IsHitTestVisible="True"
                       Click="Check_Click" />
          </StackPanel>
        </Grid>
      </ui:CardAction>

      <ItemsControl x:Name="ReleaseList" Margin="0,24,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,20">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Version}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Date}"
                           FontSize="12"
                           Opacity="0.55"
                           Margin="10,6,0,0" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Groups}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock Text="{Binding Heading}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Opacity="0.8" />
                      <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                              <TextBlock Text="&#x2022;"
                                         FontSize="13"
                                         Opacity="0.6"
                                         Margin="4,0,8,0" />
                              <TextBlock Text="{Binding}"
                                         FontSize="13"
                                         Opacity="0.85"
                                         TextWrapping="Wrap"
                                         MaxWidth="620"
                                         HorizontalAlignment="Left" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <ui:Anchor Appearance="Transparent"
                   Content="All releases on GitHub"
                   Icon="{ui:SymbolIcon Open24}"
                   NavigateUri="https://github.com/Foxtrot47/RaceDock/releases" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
