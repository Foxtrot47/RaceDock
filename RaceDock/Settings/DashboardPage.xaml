<Page x:Class="RaceDock.App.Settings.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Style="{StaticResource SettingsPagePanelStyle}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="RaceDock Settings"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText"
                   FontSize="13"
                   Opacity="0.55"
                   Margin="10,6,0,0" />
      </StackPanel>

      <TextBlock Text="Home"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Margin="0,36,0,12" />

      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <ui:Button Appearance="Transparent"
                   BorderBrush="Transparent"
                   Padding="10"
                   Margin="0,0,24,0"
                   Click="ViewUpdates_Click">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="ArrowSync24"
                           FontSize="24"
                           Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="View updates" FontWeight="SemiBold" />
              <TextBlock Text="Learn what's new"
                         FontSize="12"
                         Opacity="0.65" />
            </StackPanel>
          </StackPanel>
        </ui:Button>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="CheckmarkCircle24"
                         Filled="True"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                         FontSize="24"
                         Margin="0,0,12,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Updates managed by Windows" FontWeight="SemiBold" />
            <TextBlock Text="Use View updates for release notes"
                       FontSize="12"
                       Opacity="0.65" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <TextBlock Text="Championships"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Margin="0,0,0,6" />

      <ItemsControl x:Name="ChampionshipStatusList"
                    ItemsSource="{Binding DashboardChampionshipStatuses}"
                    Margin="-4">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:CardAction Tag="{Binding NavigationKey}"
                           Margin="4"
                           Padding="12,14"
                           HorizontalContentAlignment="Stretch"
                           VerticalContentAlignment="Center"
                           IsChevronVisible="True"
                           ToolTip="{Binding StatusTooltip}"
                           Style="{StaticResource SettingsChampionshipCardStyle}"
                           Click="SettingsCard_Click">
              <ui:CardAction.Icon>
                <ui:ImageIcon Width="32"
                              Height="32"
                              Source="{Binding IconSource}" />
              </ui:CardAction.Icon>
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="96" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding UpcomingSummary}"
                             FontSize="11"
                             Opacity="0.6"
                             Margin="0,2,0,0"
                             TextTrimming="CharacterEllipsis"
                             Visibility="{Binding HasUpcoming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <ui:InfoBadge Grid.Column="1"
                              Margin="12,0,0,0"
                              Style="{StaticResource SettingsStatusBadgeStyle}" />
              </Grid>
            </ui:CardAction>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid Margin="-4,45,-4,-4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:CardAction Grid.Column="0"
                       Tag="General"
                       Margin="4"
                       Padding="12,20"
                       IsChevronVisible="True"
                       Click="SettingsCard_Click">
          <ui:CardAction.Icon>
            <ui:SymbolIcon Symbol="Settings24" FontSize="28" />
          </ui:CardAction.Icon>
          <TextBlock Text="General" FontWeight="SemiBold" />
        </ui:CardAction>

        <ui:CardAction Grid.Column="1"
                       Tag="About"
                       Margin="4"
                       Padding="12,20"
                       IsChevronVisible="True"
                       Click="SettingsCard_Click">
          <ui:CardAction.Icon>
            <ui:SymbolIcon Symbol="Info24" FontSize="28" />
          </ui:CardAction.Icon>
          <TextBlock Text="About" FontWeight="SemiBold" />
        </ui:CardAction>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
