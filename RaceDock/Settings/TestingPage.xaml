<Page x:Class="RaceDock.App.Settings.TestingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:RaceDock.Core;assembly=RaceDock.Core"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Style="{StaticResource SettingsPagePanelStyle}">
      <TextBlock Text="Testing" Style="{StaticResource SettingsPageTitleStyle}" />
      <TextBlock Text="Replay a timing archive or RaceDock F1 feed dump, or drive a deterministic scenario without waiting for a live session."
                 Style="{StaticResource SettingsPageDescriptionStyle}" />

      <!--  Transport bar: what is driving the widget, and every playback control, in one fixed place.  -->
      <Border Style="{StaticResource SettingsTransportBarStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="TransportStateBadge" Style="{StaticResource SettingsTransportBadgeStyle}">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="TransportStateDot"
                         Style="{StaticResource SettingsTransportDotStyle}" />
                <TextBlock x:Name="TransportStateText"
                           Text="LIVE"
                           Style="{StaticResource SettingsTransportBadgeTextStyle}" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
              <TextBlock x:Name="TransportPrimaryText"
                         Text="Live streams are active"
                         FontSize="13"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="TransportSecondaryText"
                         FontSize="11.5"
                         TextTrimming="CharacterEllipsis"
                         Visibility="Collapsed"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="TransportFrameText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </Grid>

          <Grid x:Name="TransportControls" Margin="0,14,0,0" IsEnabled="False">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <ui:Button x:Name="PlayPauseButton"
                         Style="{StaticResource SettingsTransportButtonStyle}"
                         Icon="{ui:SymbolIcon Play24}"
                         ToolTip="Resume"
                         Click="PlayPauseButton_Click" />
              <ui:Button Style="{StaticResource SettingsTransportButtonStyle}"
                         Icon="{ui:SymbolIcon Next24}"
                         ToolTip="Advance one frame"
                         Click="SingleStepButton_Click" />
              <ui:Button Style="{StaticResource SettingsTransportButtonStyle}"
                         Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                         ToolTip="Restart from the first frame"
                         Click="RestartButton_Click" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Speed"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Slider x:Name="SpeedSlider"
                      Minimum="0.25"
                      Maximum="20"
                      Value="4"
                      Width="190"
                      TickFrequency="0.25"
                      IsSnapToTickEnabled="True"
                      VerticalAlignment="Center"
                      ValueChanged="SpeedSlider_ValueChanged" />
              <TextBlock x:Name="SpeedValueText"
                         Text="4.00x"
                         Width="50"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         TextAlignment="Right"
                         FontFamily="Consolas" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <ui:InfoBar x:Name="TestingInfoBar"
                  Margin="0,0,0,10"
                  IsOpen="False"
                  IsClosable="True"
                  Severity="Error" />

      <TextBlock Text="Source" Style="{StaticResource SettingsSectionTitleStyle}" />
      <TextBlock Text="One source drives the widget at a time. Either option replaces the live feeds until you return to live."
                 Style="{StaticResource SettingsSectionDescriptionStyle}" />

      <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon Bug24}">
        <ui:CardControl.Header>
          <StackPanel HorizontalAlignment="Left">
            <TextBlock Text="Deterministic scenario" Style="{StaticResource SettingsCardTitleStyle}" />
            <TextBlock Text="Replace live streams with the scripted feed you drive by hand."
                       Style="{StaticResource SettingsCardDescriptionStyle}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="TestModeToggle"
                         Style="{StaticResource SettingsToggleStyle}"
                         Checked="TestModeToggle_Checked"
                         Unchecked="TestModeToggle_Unchecked" />
      </ui:CardControl>

      <ui:CardControl x:Name="ArchiveCard"
                      Style="{StaticResource SettingsCardStyle}"
                      Icon="{ui:SymbolIcon FolderOpen20}"
                      AllowDrop="True"
                      Drop="ArchiveCard_Drop"
                      DragOver="ArchiveCard_DragOver">
        <ui:CardControl.Header>
          <StackPanel HorizontalAlignment="Left">
            <TextBlock Text="Timing archive" Style="{StaticResource SettingsCardTitleStyle}" />
            <TextBlock x:Name="ArchiveSummaryText"
                       Text="Drop a Timing71 ZIP, HAR capture, or RaceDock F1 NDJSON dump here, or browse for one."
                       Style="{StaticResource SettingsCardDescriptionStyle}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Choose archive…"
                     Icon="{ui:SymbolIcon DocumentSearch20}"
                     Click="ChooseArchiveButton_Click" />
          <ui:Button x:Name="ReturnToLiveButton"
                     Content="Return to live"
                     Margin="8,0,0,0"
                     IsEnabled="False"
                     Click="ReturnToLiveButton_Click" />
        </StackPanel>
      </ui:CardControl>

      <TextBlock Text="Scenario" Style="{StaticResource SettingsSectionTitleStyle}" />
      <TextBlock x:Name="ScenarioHintText"
                 Text="Enable the deterministic scenario to drive track, feed, and classification states."
                 Style="{StaticResource SettingsSectionDescriptionStyle}" />

      <StackPanel x:Name="ScenarioControlsPanel" IsEnabled="False">
        <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon Flag24}">
          <ui:CardControl.Header>
            <StackPanel HorizontalAlignment="Left">
              <TextBlock Text="Track state" Style="{StaticResource SettingsCardTitleStyle}" />
              <TextBlock Text="One condition is active at a time."
                         Style="{StaticResource SettingsCardDescriptionStyle}" />
            </StackPanel>
          </ui:CardControl.Header>
          <WrapPanel HorizontalAlignment="Right" MaxWidth="360">
            <WrapPanel.Resources>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource SettingsSegmentedButtonStyle}" />
            </WrapPanel.Resources>
            <ToggleButton x:Name="GreenButton" Content="Green" Tag="{x:Static core:ScenarioCommand.Green}" Click="ScenarioCommandButton_Click" />
            <ToggleButton x:Name="YellowButton" Content="Yellow" Tag="{x:Static core:ScenarioCommand.Yellow}" Click="ScenarioCommandButton_Click" />
            <ToggleButton x:Name="DoubleYellowButton" Content="Double yellow" Tag="{x:Static core:ScenarioCommand.DoubleYellow}" Click="ScenarioCommandButton_Click" />
            <ToggleButton x:Name="SafetyCarButton" Content="Safety car" Tag="{x:Static core:ScenarioCommand.SafetyCar}" Click="ScenarioCommandButton_Click" />
            <ToggleButton x:Name="VirtualSafetyCarButton" Content="VSC" Tag="{x:Static core:ScenarioCommand.VirtualSafetyCar}" Click="ScenarioCommandButton_Click" />
            <ToggleButton x:Name="VirtualSafetyCarEndingButton" Content="VSC ending" Tag="{x:Static core:ScenarioCommand.VirtualSafetyCarEnding}" Click="ScenarioCommandButton_Click" />
            <ToggleButton x:Name="RedFlagButton" Content="Red flag" Tag="{x:Static core:ScenarioCommand.RedFlag}" Click="ScenarioCommandButton_Click" />
          </WrapPanel>
        </ui:CardControl>

        <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon PlugConnected24}">
          <ui:CardControl.Header>
            <StackPanel HorizontalAlignment="Left">
              <TextBlock Text="Feed state" Style="{StaticResource SettingsCardTitleStyle}" />
              <TextBlock Text="Drive the connection badge and the stale-data guard."
                         Style="{StaticResource SettingsCardDescriptionStyle}" />
            </StackPanel>
          </ui:CardControl.Header>
          <WrapPanel HorizontalAlignment="Right">
            <WrapPanel.Resources>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource SettingsSegmentedButtonStyle}" />
            </WrapPanel.Resources>
            <ToggleButton x:Name="ReconnectButton" Content="Connected" Tag="{x:Static core:ScenarioCommand.Reconnect}" Click="ScenarioCommandButton_Click" />
            <ToggleButton x:Name="StaleButton" Content="Stale" Tag="{x:Static core:ScenarioCommand.Stale}" Click="ScenarioCommandButton_Click" />
            <ToggleButton x:Name="DisconnectButton" Content="Disconnected" Tag="{x:Static core:ScenarioCommand.Disconnect}" Click="ScenarioCommandButton_Click" />
          </WrapPanel>
        </ui:CardControl>

        <ui:CardControl Style="{StaticResource SettingsCardStyle}" Icon="{ui:SymbolIcon Timer24}">
          <ui:CardControl.Header>
            <StackPanel HorizontalAlignment="Left">
              <TextBlock Text="Session events" Style="{StaticResource SettingsCardTitleStyle}" />
              <TextBlock Text="Fastest lap fires once; the chequered flag ends the session."
                         Style="{StaticResource SettingsCardDescriptionStyle}" />
            </StackPanel>
          </ui:CardControl.Header>
          <WrapPanel HorizontalAlignment="Right">
            <WrapPanel.Resources>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource SettingsSegmentedButtonStyle}" />
            </WrapPanel.Resources>
            <ToggleButton x:Name="FastestLapButton" Content="Fastest lap" Tag="{x:Static core:ScenarioCommand.FastestLap}" Click="ScenarioCommandButton_Click" />
            <ToggleButton x:Name="ChequeredButton" Content="Chequered" Tag="{x:Static core:ScenarioCommand.Chequered}" Click="ScenarioCommandButton_Click" />
          </WrapPanel>
        </ui:CardControl>

      </StackPanel>

      <TextBlock Text="Diagnostics" Style="{StaticResource SettingsSectionTitleStyle}" />
      <ui:CardControl Style="{StaticResource SettingsCardStyle}"
                      Icon="{ui:SymbolIcon DataBarVertical24}"
                      Margin="0,0,0,14">
        <ui:CardControl.Header>
          <StackPanel HorizontalAlignment="Left">
            <TextBlock Text="Dump raw feed data" Style="{StaticResource SettingsCardTitleStyle}" />
            <TextBlock x:Name="FeedDumpPathText"
                       Text="Every enabled live stream is written verbatim, one file per feed, until you switch this off. A dump can carry session tokens, so read one before you share it."
                       Style="{StaticResource SettingsCardDescriptionStyle}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="FeedDumpToggle"
                         Style="{StaticResource SettingsToggleStyle}"
                         Checked="FeedDumpToggle_Checked"
                         Unchecked="FeedDumpToggle_Unchecked" />
      </ui:CardControl>
    </StackPanel>
  </ScrollViewer>
</Page>
