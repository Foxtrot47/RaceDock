<Page x:Class="RaceDock.App.Settings.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Style="{StaticResource SettingsPagePanelStyle}">
      <TextBlock Text="♥  Meet the Developer"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Text="RaceDock is designed and maintained by foxtrot47."
                 FontSize="14"
                 Margin="4,12,0,8"
                 Opacity="0.75"
                 TextWrapping="Wrap" />

      <ui:CardExpander Icon="{ui:SymbolIcon Code24}"
                       ContentPadding="6"
                       Margin="0,0,0,8"
                       IsExpanded="False">
        <ui:CardExpander.Header>
          <TextBlock Text="Developer"
                     FontSize="14"
                     VerticalAlignment="Center" />
        </ui:CardExpander.Header>
        <TextBlock Text="foxtrot47"
                   FontSize="14"
                   Margin="8"
                   Opacity="0.75"
                   HorizontalAlignment="Left" />
      </ui:CardExpander>

      <TextBlock Text="Support RaceDock"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Margin="0,24,0,0" />
      <TextBlock Text="Your contribution helps keep RaceDock maintained and improves support for more championships and timing providers."
                 FontSize="14"
                 Margin="4,12,0,0"
                 Opacity="0.75"
                 TextWrapping="Wrap" />
      <TextBlock Text="RaceDock remains free and open source. Sponsorship is entirely optional."
                 FontSize="14"
                 Margin="4,12,0,0"
                 Opacity="0.75"
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <ui:Anchor Content="Sponsor me"
                   Icon="{ui:SymbolIcon Heart24}"
                   NavigateUri="https://github.com/sponsors/Foxtrot47"
                   Margin="0,0,4,0" />
        <ui:Anchor Content="Buy me a coffee"
                   Icon="{ui:SymbolIcon DrinkCoffee24}"
                   NavigateUri="https://ko-fi.com/foxtrot47"
                   Margin="0,0,4,0" />
      </StackPanel>

      <TextBlock Text="Open Source Licenses"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Margin="0,36,0,12" />
      <TextBlock Text="RaceDock is built with the following open-source software:"
                 FontSize="14"
                 Margin="4,0,0,0"
                 Opacity="0.75"
                 TextWrapping="Wrap" />

      <ui:CardAction Margin="4,12,4,0"
                     Padding="16,12"
                     IsChevronVisible="False"
                     IsHitTestVisible="False">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="RaceDock"
                       FontWeight="SemiBold"
                       FontSize="14" />
            <TextBlock x:Name="RaceDockVersionText"
                       FontSize="12"
                       Opacity="0.6"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="GNU GPL v3 or later"
                     FontSize="12"
                     Opacity="0.65" />
        </StackPanel>
      </ui:CardAction>

      <ui:CardAction Margin="4"
                     Padding="16,12"
                     IsChevronVisible="False"
                     IsHitTestVisible="False">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="WPF UI"
                       FontWeight="SemiBold"
                       FontSize="14" />
            <TextBlock Text="4.3.0"
                       FontSize="12"
                       Opacity="0.6"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="MIT license"
                     FontSize="12"
                     Opacity="0.65" />
        </StackPanel>
      </ui:CardAction>

      <StackPanel Orientation="Horizontal" Margin="0,24,0,12">
        <ui:SymbolIcon Symbol="Star24"
                       Filled="True"
                       Foreground="Gold"
                       FontSize="16"
                       VerticalAlignment="Center" />
        <TextBlock Text="Enjoying RaceDock?"
                   FontSize="12"
                   Opacity="0.5"
                   Margin="4,0,12,0"
                   VerticalAlignment="Center" />
        <ui:Anchor Appearance="Transparent"
                   Content="Open GitHub repository"
                   Icon="{ui:SymbolIcon Open24}"
                   NavigateUri="https://github.com/Foxtrot47/RaceDock" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
